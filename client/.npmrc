# Download each package from the URL recorded in package-lock.json instead of
# rewriting it to the configured registry's host. npm's rewrite mangles
# registries served under a path (Replit's package firewall is at
# http://package-firewall.replit.internal/npm/): packages whose names start
# with "npm", such as npm-run-path, are fetched from the wrong path and 404,
# which fails `npm ci` and the Replit build. The lockfile's integrity hashes
# still pin every package's exact bytes.
replace-registry-host=never
