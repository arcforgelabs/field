{
  // This file is the human-editable quote catalog metadata: rules, quantity
  // rules and assemblies (recipes as data). It holds no prices: every rate
  // comes from the PostgreSQL price catalogue (server/catalog), the only
  // commercial authority. The units here are structure, not prices: the unit
  // each rule measures its quantity in (`quantityUnit`) and each recipe
  // component's quantity unit. Where the catalogue sells an item in another
  // unit it must convert (server/catalog/units.js), or the rule or recipe
  // fails closed naming the item and the health page reports it.
  //
  // This is a SAMPLE catalogue for a landscaping and earthworks business. The
  // rules, quantity rules and assemblies show how Field structures a quote;
  // the productivity factors in them are illustrative, and the business
  // profile below is a placeholder. Replace both with your own before you
  // send a quote. The item uids (cat_...) name price-catalogue items your
  // installation creates; see README.md "Getting started".
  "id": "default",
  "name": "Sample Catalogue",
  "status": "staging-placeholder",
  "currency": "AUD",
  "gstRate": 0.1,
  "hoursPerDay": 8,

  // Business profile — the source of truth for identity and payment details.
  // Not hardcoded in code. Each price list / client can override.
  "businessProfile": {
    "legalName": "Your Business Pty Ltd",
    "abn": "",
    "address": "Your business address",
    "phone": "",
    "email": "quotes@example.com",
    "paymentMethods": {
      "bankTransfer": {
        "accountName": "Your Business Pty Ltd",
        "bsb": "000-000",
        "accountNumber": "00000000",
        "bank": "Your bank"
      }
    }
  },
  "executionProfile": {
    "travelHoursPerDay": 1,
    "tipTruckLoadMinutes": 30,
    "tipTruckDumpMinutes": 15,
    "defaultDumpDriveMinutesOneWay": 20,
    "accessProfiles": {
      "standard": {
        "label": "Standard access",
        "labourMultiplier": 1,
        "machineMultiplier": 1,
        "durationMultiplier": 1,
        "overheadMultiplier": 1
      },
      "limited": {
        "label": "Limited access",
        "labourMultiplier": 1.2,
        "machineMultiplier": 1.1,
        "durationMultiplier": 1.15,
        "overheadMultiplier": 1.1
      },
      "restricted": {
        "label": "Restricted access",
        "labourMultiplier": 1.5,
        "machineMultiplier": 1.15,
        "durationMultiplier": 1.35,
        "overheadMultiplier": 1.15
      },
      "steep": {
        "label": "Steep access",
        "labourMultiplier": 1.3,
        "machineMultiplier": 1.2,
        "durationMultiplier": 1.25,
        "overheadMultiplier": 1.1
      }
    }
  },
  "sourceNote": "Quote extraction metadata and presentation rules. Live prices and units are sourced from the price catalogue.",
  // Rules added to every quote with scoped work, priced from their items.
  "supportRuleCodes": ["site-establishment", "cleanup"],
  "quantityRules": [
    {
      "code": "soil-dump-plan",
      "stage": "candidate_groups",
      "mode": "soil_dump_plan",
      "soilRuleCode": "soil-removal",
      "haulageRuleCode": "tip-truck",
      "truckMassCapacityTonnes": 3.5,
      "truckVolumeCapacityM3": 2.1875,
      "loadingHoursPerLoad": 0.5,
      "loaderRuleCode": "mini-loader-hour",
      "disposalRuleCode": "unclean-fill-disposal",
      "vehicleHourRuleCode": "vehicle-hour",
      "vehicleKmRuleCode": "vehicle-km",
      "defaultMeasurementDepthMetres": 0.1,
      "multiSectionHaulageSection": "Soil haulage"
    },
    {
      "code": "site-levelling-plan",
      "stage": "candidate_groups",
      "mode": "volume_from_section",
      "sourceRuleCode": "soil-removal",
      "sourceSectionPattern": "levell",
      "outputRuleCode": "site-levelling"
    },
    {
      "code": "concrete-removal-plan",
      "stage": "candidate_groups",
      "mode": "concrete_removal_plan",
      "surfaceRuleCode": "concrete-surface-demolition",
      "structureRuleCode": "concrete-structure-demolition",
      "surfaceDepthMm": 100,
      "structureDepthMm": 300,
      "truckMassCapacityTonnes": 3,
      "truckVolumeCapacityM3": 1.15,
      "loadingHoursPerLoad": 1,
      "loaderRuleCode": "mini-loader-hour",
      "disposalRuleCode": "concrete-waste-disposal",
      "vehicleHourRuleCode": "vehicle-hour",
      "vehicleKmRuleCode": "vehicle-km",
      "outputRuleCode": "concrete-removal",
      "outputSection": "Concrete removal",
      "haulageRuleCode": "tip-truck",
      "haulageSection": "Concrete haulage"
    },
    {
      "code": "imported-fill-demand",
      "stage": "line_item",
      "mode": "direct_material_order",
      "appliesToRuleCodes": ["imported-fill"],
      "outputItemUid": "cat_02e5e698d73441f7bc652ce1",
      "outputItemCode": "imported-fill",
      "outputLabel": "Imported fill / topping",
      "outputUnit": "m3",
      "quantityMultiplier": 1,
      "descriptionTemplate": "Imported fill order for {quantity} m3."
    },
    {
      "code": "lawn-bundle",
      "stage": "line_item",
      "mode": "lawn_bundle",
      "appliesToRuleCodes": ["lawn-supply-prep-install"],
      "assembly": "lawn-bundle"
    },
    {
      "code": "irrigation-bundle",
      "stage": "line_item",
      "mode": "irrigation_bundle",
      "appliesToRuleCodes": ["irrigation-system-install"],
      "assembly": "irrigation-bundle"
    },
    {
      "code": "site-levelling-recipe",
      "stage": "line_item",
      "mode": "volume_excavation",
      "appliesToRuleCodes": ["site-levelling"],
      "pricingDependencies": ["EXCAVATOR-HOUR", "KANGA-HOUR"],
      "cutRatio": 0.75,
      "fillRatio": 0.25,
      "cutVolumePerHour": 2,
      "fillVolumePerHour": 2,
      "cutRuleCode": "excavator-hour",
      "fillRuleCode": "mini-loader-hour"
    },
    {
      "code": "retaining-wall-execution-recipe",
      "stage": "line_item",
      "mode": "per_unit_components",
      "appliesToRuleCodes": ["retaining-wall"],
      "pricingDependencies": [
        "SLEEPER-KENSINGTON",
        "STEEL-IBEAM-125-GALV",
        "STEEL-CCHANNEL-125-GALV",
        "CONCRETE-20KG-BAG",
        "AGPIPE-BAY",
        "FORTACON-BAY",
        "GRAVEL-20MM",
        "EXCAVATOR-HOUR",
        "KANGA-HOUR",
        "LABOURER-HOUR",
        "WELDER-HOUR",
        "VEHICLE-HOUR",
        "VEHICLE-KM",
        "SITE-ALLOWANCE-DAY",
        "ADMIN-FEE",
        "APC-DELIVERY-MINIMUM"
      ],
      "sourceNote": "Static price-list view of the retaining-wall quote rule. Exact sleeper, steel, drainage, and concrete materials are generated by the retaining_wall_exact engine from wall design.",
      "balanceComponent": {
        "code": "retaining-wall__materials-design-allowance",
        "name": "Retaining wall materials/design allowance",
        "unit": "m"
      },
      "components": [
        { "ruleCode": "labourer-hour", "quantity": 0.8 },
        { "ruleCode": "excavator-hour", "quantity": 0.2 }
      ]
    },
    {
      "code": "rock-wall-estimate-recipe",
      "stage": "line_item",
      "mode": "per_unit_components",
      "appliesToRuleCodes": ["rock-wall"],
      "pricingDependencies": ["BLUESTONE-LARGE", "EXCAVATOR-HOUR", "KANGA-HOUR", "LABOURER-HOUR"],
      "sourceNote": "Static price-list view of the rock_wall_estimate engine defaults.",
      "components": [
        { "itemUid": "cat_81fc30336acf4184955b743f", "itemCode": "BLUESTONE-LARGE", "quantity": 1 },
        { "ruleCode": "excavator-hour", "quantity": 0.35 },
        { "ruleCode": "labourer-hour", "quantity": 0.45 }
      ]
    },
    {
      "code": "soil-removal-recipe",
      "stage": "line_item",
      "mode": "bulk_loading_disposal",
      "appliesToRuleCodes": ["soil-removal"],
      "pricingDependencies": ["KANGA-HOUR", "unclean-fill-disposal"],
      "truckMassCapacityTonnes": 3.5,
      "truckVolumeCapacityM3": 2.1875,
      "loadingHoursPerLoad": 0.5,
      "loaderRuleCode": "mini-loader-hour",
      "disposalRuleCode": "unclean-fill-disposal"
    },
    {
      "code": "tip-truck-haulage-recipe",
      "stage": "line_item",
      "mode": "haulage_trip",
      "appliesToRuleCodes": ["tip-truck"],
      "pricingDependencies": ["VEHICLE-HOUR", "VEHICLE-KM"],
      "vehicleHourRuleCode": "vehicle-hour",
      "vehicleKmRuleCode": "vehicle-km"
    },
    {
      "code": "concrete-surface-demolition-recipe",
      "stage": "line_item",
      "mode": "concrete_surface_demolition",
      "appliesToRuleCodes": ["concrete-surface-demolition"],
      "pricingDependencies": ["EXCAVATOR-HOUR", "JACKHAMMER-HOUR"],
      "areaPerHour": 15,
      "maxDepthMm": 100,
      "componentRuleCodes": ["excavator-hour", "jackhammer-hour"]
    },
    {
      "code": "concrete-removal-recipe",
      "stage": "line_item",
      "mode": "bulk_loading_disposal",
      "appliesToRuleCodes": ["concrete-removal"],
      "pricingDependencies": ["KANGA-HOUR", "concrete-waste-disposal"],
      "truckMassCapacityTonnes": 3,
      "truckVolumeCapacityM3": 1.15,
      "loadingHoursPerLoad": 1,
      "loaderRuleCode": "mini-loader-hour",
      "disposalRuleCode": "concrete-waste-disposal"
    },
    {
      "code": "concrete-structure-demolition-recipe",
      "stage": "line_item",
      "mode": "concrete_structure_demolition",
      "appliesToRuleCodes": ["concrete-structure-demolition"],
      "pricingDependencies": ["EXCAVATOR-HOUR", "JACKHAMMER-HOUR"],
      "areaPerHour": 7,
      "maxDepthMm": 300,
      "componentRuleCodes": ["excavator-hour", "jackhammer-hour"]
    },
    {
      "code": "tree-supply-install-recipe",
      "stage": "line_item",
      "mode": "supply_install_bundle",
      "appliesToRuleCodes": ["tree-supply-install"],
      "pricingDependencies": ["LABOURER-HOUR", "VEHICLE-HOUR"],
      "labourRuleCode": "labourer-hour",
      "machineRuleCode": "vehicle-hour"
    },
    {
      "code": "large-tree-supply-install-recipe",
      "stage": "line_item",
      "mode": "supply_install_bundle",
      "appliesToRuleCodes": ["large-tree-supply-install"],
      "pricingDependencies": ["LABOURER-HOUR", "VEHICLE-HOUR"],
      "labourRuleCode": "labourer-hour",
      "machineRuleCode": "vehicle-hour"
    },
    {
      "code": "plant-supply-install-recipe",
      "stage": "line_item",
      "mode": "supply_install_bundle",
      "appliesToRuleCodes": ["plant-supply-install"],
      "pricingDependencies": ["LABOURER-HOUR"],
      "labourRuleCode": "labourer-hour"
    },
    {
      "code": "block-edging-supply-install-recipe",
      "stage": "line_item",
      "mode": "supply_install_bundle",
      "appliesToRuleCodes": ["block-edging-supply-install"],
      "pricingDependencies": ["LABOURER-HOUR", "KANGA-HOUR"],
      "labourRuleCode": "labourer-hour",
      "machineRuleCode": "kanga-hour"
    }
  ],
  // Assemblies: the lawn, irrigation and drainage recipes as data
  // (server/catalog/assemblies.js). Each component is a catalogue item by
  // code with a quantity expression (numbers, params, vars, + - * /,
  // parentheses, ceil/floor/round/min/max) in the unit stated; its price is
  // the catalogue's, converted only where the catalogue allows (a per-tonne
  // item cannot price a per-metre component). A `balance` component takes
  // whatever charge is left of the quoted line (the delivery allowance).
  // `tests` are worked examples checked when the catalog loads; golden
  // fixtures (server/catalog/fixtures/assembly-golden.json) prove these
  // reproduce the quantities of the hardcoded recipes they replace.
  "assemblies": [
    {
      "code": "lawn-bundle",
      "mode": "lawn_bundle",
      "label": "Lawn supply, preparation and install",
      "appliesToRuleCodes": ["lawn-supply-prep-install"],
      "match": "lawn|turf|grass|sandy loam",
      "params": [
        { "name": "area_m2", "label": "Lawn area", "unit": "m2", "required": true, "min": 0 },
        { "name": "loam_depth_m", "label": "Sandy loam depth", "unit": "m", "default": 0.1, "min": 0 }
      ],
      "vars": [
        { "name": "install_hours_per_m2", "expr": "4 / 23" },
        { "name": "reprep_hours_per_m2", "expr": "3 / 60" },
        { "name": "loam_allowance", "expr": "1.2" },
        { "name": "loam_base_m3", "expr": "round(area_m2 * loam_depth_m, 4)" }
      ],
      "components": [
        { "key": "turf", "itemUid": "cat_abed8b64a7134cc8984ba864", "itemCode": "TURF-SUPPLY-M2", "label": "Turf Supply", "unit": "m2", "qty": "area_m2", "stock": true },
        { "key": "install_labour", "itemUid": "cat_d14c246b2d4e4a3db3a33039", "itemCode": "LABOURER-HOUR", "label": "General Labourer Hour", "unit": "hour", "qty": "area_m2 * install_hours_per_m2" },
        { "key": "reprep_labour", "itemUid": "cat_d14c246b2d4e4a3db3a33039", "itemCode": "LABOURER-HOUR", "label": "General Labourer Hour", "unit": "hour", "qty": "area_m2 * reprep_hours_per_m2" },
        { "key": "delivery", "itemUid": "cat_68707fe551034fe888269864", "itemCode": "VEHICLE-HOUR", "label": "Vehicle/Truck Hour", "unit": "hour", "balance": true },
        { "key": "admin", "itemUid": "cat_e0c1d03211434e06a105e7e2", "itemCode": "ADMIN-FEE", "label": "Admin Fee", "unit": "each", "qty": "1" },
        { "key": "loam", "itemUid": "cat_cc04290e1dfc442aac1e39db", "itemCode": "SANDY-LOAM-M3", "label": "Sandy Loam", "unit": "m3", "qty": "round(loam_base_m3 * loam_allowance, 4)", "role": "material_order", "stock": true }
      ],
      "tests": [
        { "name": "80 m2 at 150 mm loam", "params": { "area_m2": 80, "loam_depth_m": 0.15 }, "expected": { "turf": 80, "install_labour": 13.913, "reprep_labour": 4, "admin": 1, "loam": 14.4 } },
        { "name": "23 m2 at the default depth", "params": { "area_m2": 23 }, "expected": { "turf": 23, "install_labour": 4, "reprep_labour": 1.15, "loam": 2.76 } }
      ]
    },
    {
      "code": "irrigation-bundle",
      "mode": "irrigation_bundle",
      "label": "Irrigation system supply and install",
      "appliesToRuleCodes": ["irrigation-system-install"],
      "match": "irrigation|sprinkler|controller|drip line",
      "params": [
        { "name": "area_m2", "label": "Irrigated area", "unit": "m2", "required": true, "min": 0 },
        { "name": "controller", "label": "Controller option", "type": "enum", "options": ["battery", "mains", "mains_no_install"], "default": "battery" }
      ],
      "vars": [
        { "name": "conduit_hours", "expr": "80 / 60" },
        { "name": "pipe_install_hours_per_m2", "expr": "4 / 60" },
        { "name": "mains_install_extra_hours", "expr": "2" }
      ],
      "components": [
        { "key": "battery_controller", "itemUid": "cat_2dcbafbb1eb74b8f8443003c", "itemCode": "IRRIGATION-CONTROLLER-BATTERY", "label": "Battery Irrigation Controller", "unit": "each", "qty": "controller_battery", "omitWhenZero": true, "stock": true },
        { "key": "mains_controller", "itemUid": "cat_35224fbbfd4845b090087895", "itemCode": "IRRIGATION-CONTROLLER-MAINS", "label": "Mains Irrigation Controller", "unit": "each", "qty": "controller_mains + controller_mains_no_install", "omitWhenZero": true, "stock": true },
        { "key": "pipe_fixings", "itemUid": "cat_d5747ce2724f40fca28b61d9", "itemCode": "IRRIGATION-PIPE-FIXINGS-M2", "label": "Irrigation Pipe and Fixings", "unit": "m2", "qty": "area_m2", "stock": true },
        { "key": "conduit_labour", "itemUid": "cat_d14c246b2d4e4a3db3a33039", "itemCode": "LABOURER-HOUR", "label": "General Labourer Hour", "unit": "hour", "qty": "conduit_hours" },
        { "key": "pipe_labour", "itemUid": "cat_d14c246b2d4e4a3db3a33039", "itemCode": "LABOURER-HOUR", "label": "General Labourer Hour", "unit": "hour", "qty": "area_m2 * pipe_install_hours_per_m2" },
        { "key": "wiring_labour", "itemUid": "cat_d14c246b2d4e4a3db3a33039", "itemCode": "LABOURER-HOUR", "label": "General Labourer Hour", "unit": "hour", "qty": "controller_mains * mains_install_extra_hours", "omitWhenZero": true },
        { "key": "delivery", "itemUid": "cat_68707fe551034fe888269864", "itemCode": "VEHICLE-HOUR", "label": "Vehicle/Truck Hour", "unit": "hour", "balance": true },
        { "key": "admin", "itemUid": "cat_e0c1d03211434e06a105e7e2", "itemCode": "ADMIN-FEE", "label": "Admin Fee", "unit": "each", "qty": "1" }
      ],
      "tests": [
        { "name": "battery, 10 m2", "params": { "area_m2": 10, "controller": "battery" }, "expected": { "battery_controller": 1, "mains_controller": 0, "pipe_fixings": 10, "conduit_labour": 1.3333, "pipe_labour": 0.6667, "wiring_labour": 0, "admin": 1 } },
        { "name": "mains, 23 m2", "params": { "area_m2": 23, "controller": "mains" }, "expected": { "battery_controller": 0, "mains_controller": 1, "pipe_labour": 1.5333, "wiring_labour": 2 } },
        { "name": "mains without install, 150 m2", "params": { "area_m2": 150, "controller": "mains_no_install" }, "expected": { "mains_controller": 1, "pipe_labour": 10, "wiring_labour": 0 } }
      ]
    },
    {
      "code": "drainage-bundle",
      "mode": "drainage_bundle",
      "label": "Drainage trench, pipe and pits",
      "appliesToRuleCodes": ["drainage", "stormwater", "stormwater-drainage"],
      "match": "drainage|stormwater|\\bdrain\\b|trench|ag pipe|socked agg|junction pit",
      "params": [
        { "name": "length_m", "label": "Trench length", "unit": "m", "required": true, "min": 0 },
        { "name": "explicit_pits", "label": "Pit count stated in the scope (1) or not (0)", "default": 0, "min": 0, "max": 1 },
        { "name": "stated_pit_count", "label": "Pit count stated in the scope", "default": 0, "min": 0 }
      ],
      "vars": [
        { "name": "pit_spacing_m", "expr": "10" },
        { "name": "excavator_hours_per_m", "expr": "8 / 60" },
        { "name": "labour_hours_per_m", "expr": "12 / 60" },
        { "name": "pit_count", "expr": "explicit_pits * max(1, round(stated_pit_count)) + (1 - explicit_pits) * max(1, ceil(length_m / pit_spacing_m))" }
      ],
      "components": [
        { "key": "pipe", "itemCode": "DRAIN-PIPE-M", "label": "Drainage Pipe", "unit": "m", "qty": "length_m", "stock": true },
        { "key": "pit", "itemCode": "DRAIN-PIT", "label": "Stormwater Pit", "unit": "each", "qty": "pit_count", "stock": true },
        { "key": "gravel", "itemCode": "DRAIN-GRAVEL-M", "label": "Drainage Gravel", "unit": "m", "qty": "length_m", "stock": true },
        { "key": "disposal", "itemUid": "cat_2d051e7aa6d34a70b734182f", "itemCode": "clean-fill-disposal", "label": "Clean Fill Disposal", "unit": "m", "qty": "length_m" },
        { "key": "excavator", "itemUid": "cat_8cb11ceea88e41159072f17e", "itemCode": "EXCAVATOR-HOUR", "label": "Excavator Hour (incl. operator)", "unit": "hour", "qty": "length_m * excavator_hours_per_m" },
        { "key": "labour", "itemUid": "cat_d14c246b2d4e4a3db3a33039", "itemCode": "LABOURER-HOUR", "label": "General Labourer Hour", "unit": "hour", "qty": "length_m * labour_hours_per_m" },
        { "key": "delivery", "itemUid": "cat_68707fe551034fe888269864", "itemCode": "VEHICLE-HOUR", "label": "Vehicle/Truck Hour", "unit": "hour", "balance": true },
        { "key": "admin", "itemUid": "cat_e0c1d03211434e06a105e7e2", "itemCode": "ADMIN-FEE", "label": "Admin Fee", "unit": "each", "qty": "1" }
      ],
      "tests": [
        { "name": "25.5 m, pits from spacing", "params": { "length_m": 25.5 }, "expected": { "pipe": 25.5, "pit": 3, "gravel": 25.5, "disposal": 25.5, "excavator": 3.4, "labour": 5.1, "admin": 1 } },
        { "name": "41 m with 2 pits stated", "params": { "length_m": 41, "explicit_pits": 1, "stated_pit_count": 2 }, "expected": { "pit": 2, "excavator": 5.4667, "labour": 8.2 } },
        { "name": "3 m still gets one pit", "params": { "length_m": 3 }, "expected": { "pit": 1 } }
      ]
    }
  ],
  "deliveryDefaults": {
    "validityDays": 14,
    "paymentTerms": "10% deposit due upon acceptance of this quote to secure booking. 30% progress payment due upon commencement of works. Remaining balance due within 7 days of project completion.",
    "footerNote": "This quote is based on the listed scope, rate card, and assumptions current at issue time."
  },
  "missingInputDefaults": {
    "wall type/specification": {
      "inputType": "select",
      "defaultValue": "Standard concrete sleeper retaining wall construction.",
      "quoteNote": "Priced as a standard concrete sleeper retaining wall system.",
      "affectsPricing": true,
      "alternatives": [
        { "value": "Standard concrete sleeper retaining wall construction.", "label": "Concrete sleeper" },
        { "value": "Treated timber sleeper retaining wall construction.", "label": "Timber sleeper" },
        { "value": "Galvanised steel post and concrete sleeper system.", "label": "Steel post + concrete sleeper" },
        { "value": "Rock or boulder retaining wall.", "label": "Rock / boulder wall" },
        { "value": "Crib wall block system.", "label": "Crib block" }
      ]
    },
    "retaining wall type/specification": {
      "inputType": "select",
      "defaultValue": "Standard concrete sleeper retaining wall construction.",
      "quoteNote": "Priced as a standard concrete sleeper retaining wall system.",
      "affectsPricing": true,
      "alternatives": [
        { "value": "Standard concrete sleeper retaining wall construction.", "label": "Concrete sleeper" },
        { "value": "Treated timber sleeper retaining wall construction.", "label": "Timber sleeper" },
        { "value": "Galvanised steel post and concrete sleeper system.", "label": "Steel post + concrete sleeper" },
        { "value": "Rock or boulder retaining wall.", "label": "Rock / boulder wall" },
        { "value": "Crib wall block system.", "label": "Crib block" }
      ]
    },
    "wall height profile": {
      "inputType": "select",
      "defaultValue": "Assume a uniform retained height based on the stated wall height in the recording.",
      "quoteNote": "Priced using a uniform wall profile rather than stepped or engineered height changes.",
      "affectsPricing": true,
      "alternatives": [
        { "value": "Assume a uniform retained height based on the stated wall height in the recording.", "label": "Uniform height" },
        { "value": "Stepped wall profile with height changes along the run.", "label": "Stepped profile" },
        { "value": "Engineered height profile with structural certification.", "label": "Engineered profile" }
      ]
    },
    "wall length": {
      "inputType": "text",
      "defaultValue": "Use the extracted wall length stated in the recording.",
      "quoteNote": "Priced using the stated lineal metre length from the transcript.",
      "affectsPricing": true
    },
    "site access constraints": {
      "inputType": "select",
      "defaultValue": "Assume standard site access with no unusual machinery, haulage, or handling constraints.",
      "quoteNote": "No unusual access loading has been added unless separately noted.",
      "affectsPricing": true,
      "alternatives": [
        { "value": "Assume standard site access with no unusual machinery, haulage, or handling constraints.", "label": "Standard access" },
        { "value": "Limited access — mini excavator only, no truck entry to site.", "label": "Limited (mini excavator)" },
        { "value": "Restricted access — hand carry materials, no machine access.", "label": "Restricted (hand carry)" },
        { "value": "Steep site — additional machinery and safety requirements.", "label": "Steep site" }
      ]
    },
    "set-out and establishment scope": {
      "inputType": "select",
      "defaultValue": "Allow one standard site establishment and set-out visit.",
      "quoteNote": "Site establishment is assumed to be a standard single setup.",
      "affectsPricing": true,
      "alternatives": [
        { "value": "Allow one standard site establishment and set-out visit.", "label": "Single setup" },
        { "value": "Two-stage establishment — initial setup plus return for wall build.", "label": "Two-stage setup" }
      ]
    },
    "estimated machine hours": {
      "inputType": "text",
      "defaultValue": "Assume 4 machine hours unless revised on site.",
      "quoteNote": "Machine allowance uses the profile default until an exact duration is provided.",
      "affectsPricing": true
    },
    "estimated labour hours": {
      "inputType": "text",
      "defaultValue": "Assume one standard labour day of 7 hours unless revised.",
      "quoteNote": "Labour allowance uses the default standard day until a confirmed duration is supplied.",
      "affectsPricing": true
    },
    "excavation and labour hours": {
      "inputType": "text",
      "defaultValue": "Assume one standard combined excavation/labour day of 7 hours.",
      "quoteNote": "Excavation and labour have been priced from a standard default allowance.",
      "affectsPricing": true
    },
    "fill volume": {
      "inputType": "text",
      "defaultValue": "Assume standard imported fill volume from the default profile.",
      "quoteNote": "Imported fill uses the profile default until a measured volume is provided.",
      "affectsPricing": true
    },
    "soil-out volume": {
      "inputType": "text",
      "defaultValue": "Assume standard spoil-out volume from the default profile.",
      "quoteNote": "Soil removal uses the profile default until measured excavation volume is provided.",
      "affectsPricing": true
    },
    "drainage run length": {
      "inputType": "text",
      "defaultValue": "Assume the standard drainage run length from the default profile.",
      "quoteNote": "Drainage is priced from the default length allowance until a measured run is supplied.",
      "affectsPricing": true
    },
    "material quantities": {
      "inputType": "select",
      "defaultValue": "Assume standard material quantities derived from the base rate card.",
      "quoteNote": "Material quantities are provisionally covered by the default rate card assumptions.",
      "affectsPricing": true,
      "alternatives": [
        { "value": "Assume standard material quantities derived from the base rate card.", "label": "Standard quantities" },
        { "value": "Reduced material scope — lightweight or partial build.", "label": "Reduced scope" },
        { "value": "Heavy material scope — oversized or reinforced build.", "label": "Heavy scope" }
      ]
    },
    "haulage count or truck loads": {
      "inputType": "text",
      "defaultValue": "Assume one standard haulage load unless revised.",
      "quoteNote": "Haulage is priced using the default single-load allowance.",
      "affectsPricing": true
    },
    "manual scope review": {
      "inputType": "text",
      "defaultValue": "Assume standard site works allowance pending manual scope review.",
      "quoteNote": "A provisional general site works allowance has been retained until scope is refined.",
      "affectsPricing": true
    },
    "lawn area": {
      "inputType": "text",
      "defaultValue": "Assume a standard lawn zone size based on the current job context until confirmed.",
      "quoteNote": "Lawn pricing uses a standard area assumption until measured dimensions are captured.",
      "affectsPricing": true
    }
  },
